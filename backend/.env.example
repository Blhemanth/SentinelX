# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/sentinelx

# JWT
JWT_ACCESS_SECRET=your_access_secret_min_64_chars_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_min_64_chars_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ML Service (Python FastAPI)
ML_SERVICE_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Admin Bootstrap
ADMIN_EMAIL=admin@sentinelx.local

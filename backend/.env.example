# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/sentinelx

# JWT Configuration
# In production, generate separate 64-character random hex strings:
# Example: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_openssl_rand_hex_32_minimum_64_chars_access_secret
JWT_REFRESH_SECRET=replace_with_openssl_rand_hex_32_different_minimum_64_chars_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS Allowed Origins (comma-separated list for web clients)
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ML Service (Python FastAPI)
ML_SERVICE_URL=http://localhost:8000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Admin Bootstrap
ADMIN_EMAIL=admin@sentinelx.local
ADMIN_PASSWORD=ChangeMe!2024
